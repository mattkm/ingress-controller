# Build the custom controller without changing the upstream release Dockerfile.
FROM --platform=$BUILDPLATFORM node:22-bookworm@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7 AS node
FROM --platform=$BUILDPLATFORM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS build
COPY --from=node /usr/local/ /usr/local/
WORKDIR /src
COPY . .
ARG TARGETARCH=arm64
ARG VERSION=v0.33.4-secret-scope.2
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build make envoy-ci pomerium-ui
# Full command-package tests include flag parsing and cache integration below.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build assets="$(go run sigs.k8s.io/controller-runtime/tools/setup-envtest@v0.0.0-20251010203701-b9bccfd41914 use 1.36.x -p path)" \
    && test -n "$assets" \
    && KUBEBUILDER_ASSETS="$assets" go test -tags embed_pomerium ./cmd ./util/secretcache -run 'TestSecret' -count=1 -v
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build go test -tags embed_pomerium ./controllers/ingress ./controllers/settings ./pomerium/ctrl -run 'Test(ManagingIngressClass|Once|Fetch|SecretsDecode|ApplyAdditional|ConfigChangeDetect)' -count=1
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -tags embed_pomerium \
    -ldflags="-X github.com/pomerium/ingress-controller/internal/version.Version=${VERSION} -X github.com/pomerium/ingress-controller/internal/version.PomeriumVersion=$(go list -f '{{.Module.Version}}' github.com/pomerium/pomerium)" \
    -o /out/manager main.go
FROM gcr.io/distroless/base-nossl-debian12:debug-nonroot@sha256:32d0efd5a21d0274ba4d04c5bc233fec686a4d5fe28aca3447926d5304f1b102
COPY --from=build /out/manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
