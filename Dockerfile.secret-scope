# Build the custom controller without changing the upstream release Dockerfile.
FROM --platform=$BUILDPLATFORM node:22-bookworm@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7 AS node
FROM --platform=$BUILDPLATFORM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS build
COPY --from=node /usr/local/ /usr/local/
WORKDIR /src
COPY . .
ARG TARGETARCH=arm64
ARG VERSION=v0.33.6-secret-scope.1
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build make envoy-ci pomerium-ui
# Full command-package tests include flag parsing and cache integration below.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build assets="$(go run sigs.k8s.io/controller-runtime/tools/setup-envtest@v0.0.0-20251010203701-b9bccfd41914 use 1.36.x -p path)" \
    && test -n "$assets" \
    && KUBEBUILDER_ASSETS="$assets" go test -tags embed_pomerium ./cmd ./util/secretcache -run 'Test(Secret|AllInOneSignOutRedirect)' -count=1 -v
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build go test -tags embed_pomerium ./controllers/ingress ./controllers/settings ./pomerium/ctrl -run 'Test(ManagingIngressClass|Once|Fetch|SecretsDecode|ApplyAdditional|ConfigChangeDetect)' -count=1
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -tags embed_pomerium \
    -ldflags="-X github.com/pomerium/ingress-controller/internal/version.Version=${VERSION} -X github.com/pomerium/ingress-controller/internal/version.PomeriumVersion=$(go list -f '{{.Module.Version}}' github.com/pomerium/pomerium)" \
    -o /out/manager main.go
FROM --platform=$BUILDPLATFORM debian:bookworm-20261020@sha256:854dd8ab51d62866dbd8f5431d15ce77b12983a2a4a1e1fe43a2395dc7ef9f61 AS distroless-ca-certificates
RUN --mount=type=tmpfs,target=/var/cache/apt \
    --mount=type=tmpfs,target=/var/lib/apt/lists \
    apt-get -qq update \
    && DEBIAN_FRONTEND=noninteractive apt-get -qq install --no-install-recommends -y ca-certificates \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge '20250419~deb12u2' \
    && mkdir -p /out/etc/ssl/certs /out/usr/share/doc/ca-certificates /out/var/lib/dpkg/status.d \
    && cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/ \
    && cp /usr/share/doc/ca-certificates/copyright /out/usr/share/doc/ca-certificates/ \
    && dpkg-query -s ca-certificates | grep -v '^Status:' > /out/var/lib/dpkg/status.d/ca-certificates \
    && cp /var/lib/dpkg/info/ca-certificates.md5sums /out/var/lib/dpkg/status.d/

FROM gcr.io/distroless/base-nossl-debian12:debug-nonroot@sha256:83b8737817cda240f3f75e9acaa2b6fa547e2693e7e8dc4594c7ce98a0e5765e
COPY --from=distroless-ca-certificates --chown=0:0 /out/ /
COPY --from=build /out/manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
